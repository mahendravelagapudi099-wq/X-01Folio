VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: hosted form endpoint for the contact form (e.g. Formspree / a serverless
# function). When unset, the form falls back to a mailto: compose window, which is the
# right default for a static GitHub Pages deployment.
# VITE_CONTACT_ENDPOINT=https://your-form-endpoint.example/submit
